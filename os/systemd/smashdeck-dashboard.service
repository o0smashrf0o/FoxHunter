[Unit]
Description=SmashDeck dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smash
Group=smash
WorkingDirectory=/opt/smashdeck/dashboard
Environment=SMASHDECK_PREFIX=/opt/smashdeck
Environment=SMASHDECK_DATA=/home/smash/.local/share/smashdeck
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/smashdeck/.venv/bin/python /opt/smashdeck/dashboard/app.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
