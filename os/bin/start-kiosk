#!/usr/bin/env bash
# Fullscreen HUD. Chromium --kiosk is reliable on Pi OS labwc (GTK windows stay tiny).
set +e
PREFIX="${FOXHUNTER_PREFIX:-${SMASHDECK_PREFIX:-}}"
if [[ -z "$PREFIX" ]]; then
  if [[ -d /opt/foxhunter ]]; then PREFIX=/opt/foxhunter
  else PREFIX=/opt/smashdeck
  fi
fi
URL="${FOXHUNTER_URL:-${SMASHDECK_URL:-http://127.0.0.1:8080/}}"
export DISPLAY="${DISPLAY:-:0}"
export GTK_A11Y=none
export LIBGL_ALWAYS_SOFTWARE=1
export WEBKIT_DISABLE_COMPOSITING_MODE=1
export WEBKIT_DISABLE_DMABUF_RENDERER=1

restore_panel() {
  if pgrep -x wf-panel-pi >/dev/null 2>&1 || \
     pgrep -x lxpanel >/dev/null 2>&1; then
    return 0
  fi

  if command -v wf-panel-pi >/dev/null 2>&1; then
    wf-panel-pi >/dev/null 2>&1 &
  elif command -v lxpanel >/dev/null 2>&1; then
    lxpanel --profile LXDE-pi >/dev/null 2>&1 &
  fi
}

# don't let the Pi panel sit on top of the HUD
killall wf-panel-pi 2>/dev/null
killall lxpanel 2>/dev/null

sleep 2
for _ in $(seq 1 50); do
  curl -sf -o /dev/null "$URL" && break
  sleep 0.2
done

W=800
H=480
if command -v wlr-randr >/dev/null 2>&1; then
  geo=$(wlr-randr 2>/dev/null | awk '/current/{print $1; exit}')
  W=${geo%x*}
  H=${geo#*x}
fi
W=${W:-800}
H=${H:-480}

for c in chromium-browser chromium google-chrome; do
  if command -v "$c" >/dev/null 2>&1; then
    "$c" \
      --kiosk --start-fullscreen \
      --window-position=0,0 \
      --window-size="${W},${H}" \
      --ozone-platform=x11 \
      --disable-gpu --disable-gpu-compositing \
      --use-gl=disabled \
      --disable-accelerated-2d-canvas \
      --disable-accelerated-video-decode \
      --disable-features=VizDisplayCompositor,UseSkiaRenderer,GpuRasterization,CanvasOopRasterization,TranslateUI \
      --num-raster-threads=1 \
      --disable-partial-raster \
      --disable-smooth-scrolling \
      --noerrdialogs --disable-infobars \
      --disable-session-crashed-bubble \
      --disable-translate --disable-extensions \
      --disable-dev-shm-usage --no-first-run \
      --check-for-update-interval=31536000 \
      --renderer-process-limit=1 \
      --app="$URL" "$URL" &
    cpid=$!
    sleep 2
    if command -v xdotool >/dev/null 2>&1; then
      xdotool search --sync --onlyvisible --class chromium windowactivate --sync 2>/dev/null
      xdotool click --repeat 2 1 2>/dev/null
    fi
    wait "$cpid"
    restore_panel
    exit 0
  fi
done

if [[ -f "$PREFIX/foxhunter-kiosk" ]]; then
  python3 "$PREFIX/foxhunter-kiosk" "$URL"
  restore_panel
  exit 0
fi
xdg-open "$URL"
restore_panel
