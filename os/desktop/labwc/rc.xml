<?xml version="1.0"?>
<labwc_config>
  <core>
    <gap>0</gap>
  </core>
  <theme>
    <name>PiXtrix</name>
    <cornerRadius>0</cornerRadius>
  </theme>
  <windowRules>
    <windowRule identifier="smashdeck" serverDecoration="no" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="Maximize"/>
      <action name="ToggleFullscreen"/>
    </windowRule>
    <windowRule identifier="SmashDeck" serverDecoration="no" skipTaskbar="yes">
      <action name="Maximize"/>
      <action name="ToggleFullscreen"/>
    </windowRule>
    <windowRule identifier="chromium*" serverDecoration="no" skipTaskbar="yes">
      <action name="Maximize"/>
      <action name="ToggleFullscreen"/>
    </windowRule>
    <windowRule identifier="Chromium*" serverDecoration="no" skipTaskbar="yes">
      <action name="Maximize"/>
      <action name="ToggleFullscreen"/>
    </windowRule>
    <windowRule identifier="org.gnome.Epiphany*" serverDecoration="no">
      <action name="Maximize"/>
      <action name="ToggleFullscreen"/>
    </windowRule>
  </windowRules>
</labwc_config>
