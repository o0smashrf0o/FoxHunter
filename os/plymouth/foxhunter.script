# Fox Hunter OS splash — contain (no stretch) on black
Window.SetBackgroundTopColor(0.00, 0.00, 0.00);
Window.SetBackgroundBottomColor(0.00, 0.00, 0.00);
img = Image("splash.png");
iw = img.GetWidth();
ih = img.GetHeight();
sw = Window.GetWidth();
sh = Window.GetHeight();
scale = sw / iw;
if (ih * scale > sh) {
  scale = sh / ih;
}
nw = iw * scale;
nh = ih * scale;
sprite = Sprite(img.Scale(nw, nh));
sprite.SetX((sw - nw) / 2);
sprite.SetY((sh - nh) / 2);
sprite.SetZ(-100);
