#!/usr/bin/env python3
"""Lightweight fullscreen WebKit kiosk. Much cheaper than Chromium on Pi."""
from __future__ import annotations

import sys

URL = sys.argv[1] if len(sys.argv) > 1 else "http://127.0.0.1:8080/"


def main() -> int:
    try:
        import gi
        gi.require_version("Gtk", "3.0")
        try:
            gi.require_version("WebKit2", "4.1")
        except ValueError:
            gi.require_version("WebKit2", "4.0")
        from gi.repository import Gtk, Gdk, WebKit2
    except Exception as e:
        print(f"webkit kiosk unavailable: {e}", file=sys.stderr)
        return 2

    win = Gtk.Window(title="SmashDeck")
    win.set_decorated(False)
    win.fullscreen()
    win.connect("destroy", Gtk.main_quit)
    win.connect("key-press-event", _on_key)

    settings = WebKit2.Settings()
    settings.set_enable_javascript(True)
    settings.set_enable_developer_extras(False)
    settings.set_enable_offline_web_application_cache(False)
    settings.set_enable_page_cache(False)
    try:
        settings.set_hardware_acceleration_policy(WebKit2.HardwareAccelerationPolicy.ALWAYS)
    except Exception:
        pass

    view = WebKit2.WebView()
    view.set_settings(settings)
    view.load_uri(URL)
    win.add(view)
    win.show_all()
    Gtk.main()
    return 0


def _on_key(win, event):
    from gi.repository import Gdk
    if event.keyval == Gdk.KEY_Escape:
        win.destroy()
        return True
    return False


if __name__ == "__main__":
    sys.exit(main())
