# Fox Hunter udev — SDR / BT / WiFi in plugdev. Extra dongles still work via kernel drivers.
# RTL-SDR
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2838", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", ATTR{idProduct}=="2832", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="0b05", ATTR{idProduct}=="17ab", MODE="0666", GROUP="plugdev"
# HackRF / Lime / Great Scott Gadgets
SUBSYSTEM=="usb", ATTR{idVendor}=="1d50", MODE="0666", GROUP="plugdev"
# MediaTek Wi-Fi (Alfa AWUS036AXM / MT7921AU)
SUBSYSTEM=="usb", ATTR{idVendor}=="0e8d", MODE="0664", GROUP="plugdev"
# Realtek Wi-Fi (Panda PAU0F-class 88xx)
SUBSYSTEM=="usb", ATTR{idVendor}=="0bda", MODE="0664", GROUP="plugdev"
# Broadcom / SENA UD100
SUBSYSTEM=="usb", ATTR{idVendor}=="0a5c", MODE="0664", GROUP="plugdev"
KERNEL=="ttyUSB*", MODE="0666", GROUP="dialout"
KERNEL=="ttyACM*", MODE="0666", GROUP="dialout"
KERNEL=="hackrf*", MODE="0666", GROUP="plugdev"
