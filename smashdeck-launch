#!/usr/bin/env python3
"""Dev / bootstrap launcher for SmashDeck (in-tree)."""
from __future__ import annotations

import os
import sys
import time
import socket
import subprocess
from pathlib import Path

PROJECT_ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(PROJECT_ROOT))

DEV = "--dev" in sys.argv
if DEV:
    sys.argv.remove("--dev")
    os.environ["SMASHDECK_DEV"] = "1"

# Prefer system install unless --dev
_SYSTEM = Path(os.environ.get("SMASHDECK_INSTALL_PREFIX", "/opt/smashdeck"))
if not DEV and (_SYSTEM / "smashdeck-gui").is_file() and PROJECT_ROOT.resolve() != _SYSTEM.resolve():
    os.execv(sys.executable, [sys.executable, str(_SYSTEM / "smashdeck-gui"), *sys.argv[1:]])
if not DEV and not (_SYSTEM / "smashdeck-gui").is_file() and (PROJECT_ROOT / "smashdeck-gui").is_file():
    os.execv(sys.executable, [sys.executable, str(PROJECT_ROOT / "smashdeck-gui"), *sys.argv[1:]])

from utils.bootstrap import bootstrap_if_needed, reexec_into_venv, get_venv_python  # noqa: E402
from utils.paths import ensure_data_dirs  # noqa: E402

ensure_data_dirs()
bootstrap_if_needed(force="--force" in sys.argv)
reexec_into_venv()

# start dashboard
port = int(os.environ.get("SMASHDECK_PORT", "8080"))


def up() -> bool:
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.3):
            return True
    except OSError:
        return False


if not up():
    app = PROJECT_ROOT / "dashboard" / "app.py"
    py = str(get_venv_python()) if get_venv_python().is_file() else sys.executable
    log = PROJECT_ROOT / "data" / "logs" / "dashboard" / "dashboard.log"
    log.parent.mkdir(parents=True, exist_ok=True)
    logf = open(log, "a")
    subprocess.Popen(
        [py, str(app)],
        cwd=str(PROJECT_ROOT / "dashboard"),
        stdout=logf,
        stderr=subprocess.STDOUT,
        start_new_session=True,
        env={**os.environ, "SMASHDECK_DATA": str(PROJECT_ROOT / "data")},
    )
    for _ in range(40):
        time.sleep(0.25)
        if up():
            break

url = f"http://127.0.0.1:{port}/"
print(f"SmashDeck dashboard: {url}")
for c in ("chromium-browser", "chromium", "xdg-open"):
    if subprocess.call(["which", c], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL) == 0:
        if c.startswith("chrom"):
            subprocess.Popen([c, f"--app={url}"], start_new_session=True)
        else:
            subprocess.Popen([c, url], start_new_session=True)
        break
